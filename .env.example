# 실제 값은 .env 파일에 넣을 것 (.env는 커밋되지 않음)
# cp .env.example .env 후 아래 값을 채우세요.

# Supabase > Project Settings > API Keys (publishable key)
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 네이버 클라우드 플랫폼 > Maps > Application > Client ID
# (Android 패키지명 / iOS 번들ID에 com.woosan.sannote 등록 필수)
NAVER_MAP_CLIENT_ID=xxxxxxxxxx
